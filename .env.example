# Runtime environment: development | test | staging | production
APP_ENV=development

# 32+ chars; use a generated secret in non-local environments
AUTH_SECRET=replace-with-at-least-32-char-secret

# Database connection URL
DATABASE_URL=postgresql://user:password@localhost:5432/agent_sandbox

# 16+ chars token for log ingestion endpoint authentication
LOG_INGEST_TOKEN=replace-with-log-ingest-token
