{
  "name": "agent-sandbox",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test tests/seed-fixtures.test.mjs",
    "validate": "npm run lint && npm run typecheck && npm run test",
    "validate:with-db": "npm run validate && npm run db:migration:validate:local",
    "prisma:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "db:migration:validate": "node scripts/validate-migration-gate.mjs",
    "db:migration:validate:local": "node --env-file=.env scripts/validate-migration-gate.mjs",
    "db:migrate:up": "node scripts/migrate.mjs up",
    "db:migrate:down": "node scripts/migrate.mjs down",
    "db:verify-migrations": "node scripts/verify-migrations.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:e2e": "node tests/e2e/auth-profile-smoke.mjs",
    "test:perf": "node tests/perf/auth-profile-p95.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "next": "16.1.6",
    "pg": "^8.16.3",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^6.16.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  }
}
